// Durable wall-clock time, end to end. `time.now` reads the clock (a value recorded durably, so a
// recovered run agrees with itself about what time it was); `time.sleep` waits a persisted deadline that
// re-arms across a restart; `time.watch` fires an agent once per schedule occurrence. All three are built-in
// reactor calls — no FFI sidecar, nothing to install.

@"Sleep a second, timing it with the durable clock either side. The elapsed span is at least the sleep
(the deadline is persisted, so even a restart mid-sleep wakes no earlier)."
agent main() -> string {
  let before = time.now()
  time.sleep(milliseconds = 1000)
  let after = time.now()
  f"slept for ${string.to_string(value = after - before)}ms"
}

@"Entry: the CIVIL surface — the labels a wall clock is rendered into, and the arithmetic that moves a
date. Every one of these is pure over a FIXED instant and a FIXED offset, so the text below is exact and
reads the same forever: no clock is consulted at all.

The two halves are deliberately separate agents in the stdlib. `time.stamp` and its siblings RENDER —
they turn an instant into a line an app injects into a turn — while `to_civil` / `from_civil` do the
ARITHMETIC, over the calendar fields rather than over a label. A date advanced by a week is the second
kind: read the instant into its fields, add to `day`, fold it back. `from_civil` NORMALISES an
out-of-range field, which is what makes the addition total — the 32nd of July is the 1st of August, and
February 30th is March 2nd, without a single branch."
agent civil_labels() -> string {
  // 2026-07-26T05:32:00Z — a Sunday afternoon once it is read at +09:00.
  let instant = 1785043920000
  let offset = 540
  let stamp = time.stamp(epoch_milliseconds = instant, offset_minutes = offset)

  // A week on, as civil arithmetic: fields out, `day + 7`, fields back, then rendered.
  let today = time.to_civil(epoch_milliseconds = instant, offset_minutes = offset)
  let a_week_on = time.from_civil(
    value = time.civil(
      year = today.year, month = today.month, day = today.day + 7,
      hour = today.hour, minute = today.minute, second = today.second, millisecond = today.millisecond,
    ),
    offset_minutes = offset,
  )
  let next_week = time.date_label(epoch_milliseconds = a_week_on, offset_minutes = offset)

  // Normalised, not rejected: the 30th of February is a set of FIELDS, and folding them back lands on
  // the 2nd of March. There is no null to handle, because the arithmetic never had a string to parse.
  let overflowed = time.from_civil(
    value = time.civil(year = 2026, month = 2, day = 30, hour = 12, minute = 0, second = 0, millisecond = 0),
    offset_minutes = offset,
  )
  let normalized = time.date_label(epoch_milliseconds = overflowed, offset_minutes = offset)

  f"${stamp} | next week=${next_week} | 2026-02-30 normalizes to ${normalized} | half-hour zone=${time.offset_label(offset_minutes = 0 - 330)}"
}

@"A private signal used only to stop the watch below once it has seen enough occurrences."
data enough()

@"One reported occurrence — the ambient capability the watched agent performs per tick."
request note(scheduled: number) -> null

@"The watched agent: report each occurrence's scheduled instant and return. Its `note` effect flows to
whoever runs it (here, the handlers in `every_second`)."
agent report(time: number) -> null with note {
  note(scheduled = time)
}

@"Watch a one-second interval and stop after three occurrences. `time.watch` never returns on its own, so
a stateful handler counts the deliveries and, on the third, throws `enough` — which propagates out of the
watched agent, tears the watch down, and is caught here to end with a summary. This is how resilience and
termination are composed AROUND `watch` rather than baked into it."
agent every_second() -> string with io {
  use handler {
    request prelude.throw(error: enough) -> never { break "watched three occurrences" }
  }
  use handler (var seen = 0) {
    request note(scheduled: number) -> null {
      if (seen + 1 >= 3) {
        prelude.throw(error = enough())
      } else {
        next null with { seen = seen + 1 }
      }
    }
  }
  time.watch(schedule = time.interval(milliseconds = 1000), deliver_to = report)
}
