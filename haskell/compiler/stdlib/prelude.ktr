// The wired-in `prelude` module: every operator desugars to one of these agents, and the module is
// default-imported into every user module (so `prelude.add` and the stdlib submodules resolve).
// Generic bounds keep operators precise — an arithmetic operator over `T extends number` preserves
// `integer` when both operands are integers, and widens to `number` otherwise.
// Naming rule across the stdlib: the operand is `value` when the agent reads a scalar whole, and
// `target` when it reaches into a structure (an array, a record, a JSON tree, a store subtree).

// Arithmetic -------------------------------------------------------------------------------------

@"Add two numbers; preserves integer when both operands are integers."
primitive agent add[T extends number](left: T, right: T) -> T
@"Subtract two numbers; preserves integer when both operands are integers."
primitive agent subtract[T extends number](left: T, right: T) -> T
@"Multiply two numbers; preserves integer when both operands are integers."
primitive agent multiply[T extends number](left: T, right: T) -> T
@"Floor-modulo two numbers; preserves integer when both operands are integers. A zero divisor
panics (guard with a comparison first)."
primitive agent modulo[T extends number](@"The dividend." left: T, @"The divisor." right: T) -> T
@"Divide two numbers; always yields a number. A zero divisor panics (guard with a comparison
first) — division never yields Infinity / NaN."
primitive agent divide(@"The dividend." left: number, @"The divisor." right: number) -> number
@"Negate a number; preserves integer."
primitive agent negate[T extends number](value: T) -> T

// Comparison -------------------------------------------------------------------------------------

@"Whether two values are equal."
primitive agent equal[T](left: T, right: T) -> boolean
@"Whether two values are not equal."
primitive agent not_equal[T](left: T, right: T) -> boolean

// The scalar order is total and deterministic: numbers numerically, strings by Unicode code point (no
// locale), and in a mixed union every number before every string. `array.sort` shares it.

@"Whether the left value is less than the right (numbers numerically, strings by Unicode code point;
in a mixed union, numbers order before strings)."
primitive agent less_than[T extends number | string](left: T, right: T) -> boolean
@"Whether the left value is less than or equal to the right (the order of `less_than`)."
primitive agent less_or_equal[T extends number | string](left: T, right: T) -> boolean
@"Whether the left value is greater than the right (the order of `less_than`)."
primitive agent greater_than[T extends number | string](left: T, right: T) -> boolean
@"Whether the left value is greater than or equal to the right (the order of `less_than`)."
primitive agent greater_or_equal[T extends number | string](left: T, right: T) -> boolean

// Logical ----------------------------------------------------------------------------------------

@"Logical conjunction."
primitive agent and(left: boolean, right: boolean) -> boolean
@"Logical disjunction."
primitive agent or(left: boolean, right: boolean) -> boolean
@"Logical negation."
primitive agent not(value: boolean) -> boolean

// String -----------------------------------------------------------------------------------------

@"Concatenate two strings."
primitive agent concat(left: string, right: string) -> string

// Errors -----------------------------------------------------------------------------------------
//
// `throw[T]` is the program's error channel. `panic` is the runtime's own and is undeclared, so a
// program neither raises one nor names it in an effect row. It is observed through the ambient clause
// `request panic(msg: string) { ... }`, addable to any `use handler`: the checker recognizes that
// bare clause structurally and keeps it out of the continuation's effect row, so no signature gains a
// `panic`. Only an explicit `break` recovers.

@"Signal a typed error the caller may recover from; the payload is a domain-specific error `data`
(e.g. `json.parse_error`), and a handler naming that payload type catches it. `-> never` means a throw
cannot be resumed — a handler recovers by `break`ing out of the handle, or rethrows. Uncaught, it
fails the run with the payload."
request throw[T](@"The error payload; a handler naming this payload type catches it." error: T) -> never

@"Run @task@ and fold its `throw` into the result: the answer is @task@'s value, or — when it threw —
the thrown payload itself, as a plain `T | Err` union to `match` on. It catches the whole throw row
(the row is `E lacks prelude.throw`), so partial capture is written as a handler with a rethrow arm
instead. A @task@ that throws nothing leaves @Err@ with no lower bound and fails to infer (K3016), and
an instantiation where @T@ and @Err@ overlap does not distinguish the two afterwards."
agent catch[T, Err, effect E lacks prelude.throw](
  @"The work to run, written inline as an anonymous nullary agent; its throws are folded into the result." task: agent (value: null) -> T with E | prelude.throw[Err],
) -> T | Err with E {
  use handler {
    request prelude.throw(error: Err) -> never {
      break error
    }
  }
  task(value = null)
}
