// The `prelude.http` sub-module: a built-in HTTP client, routed to the runtime's `http` reactor
// (in-runtime, not an FFI sidecar), so every call performs `io`.
//
// The information-flow rule: a private value leaves the runtime only toward the request's destination
// server, through the header values and the `body`'s content. `url` and `method` are public `string`,
// since a URL travels into logs, caches, proxies and `Referer` headers. The response is public — it is
// the server's reply, not a function of the secret. A `file` in a body rides to the reactor as its
// handle and its bytes are spliced in at the send boundary, so a large upload never materialises onto
// the value plane, the durable call record, or the trace.

// `post_json` parses its reply back to a value. The `json` module qualifier is shadowed here by this
// module's own `json` body variant (below), so import `parse` / `parse_error` by name to reach them.
import { parse, type parse_error } from prelude.json

@"An HTTP request never completed: DNS failure, refused connection, timeout, or a mid-flight runtime
restart. Thrown by `fetch`. (A response that did arrive is never an error — branch on its `status`.)"
data fetch_error(message: string)

// The request body: exactly one of four shapes. A `data` constructor's own doc is not carried into the
// derived schema (only the `body:` parameter label is), so these annotations document the source.

@"A text body: the @content@ string, sent verbatim (Content-Type is the caller's to set). The @content@
may be a secret (an OAuth `refresh_token` in a form-encoded body)."
data text(content: string of private)

@"A raw-bytes body: the file @content@'s bytes, sent as-is — the shape an upload API (an S3 PUT) takes. The
Content-Type defaults to the file's recorded content type; set a `Content-Type` header to override it."
data binary(content: file)

@"A `multipart/form-data` body (RFC 7578): the @parts@, each a named form field — text or file. The
transport generates the boundary and sets the Content-Type, so do not set a `Content-Type` header for it."
data multipart(parts: array[multipart_part])

@"A JSON body from the @value@ tree (records / arrays / scalars / files, mixed), serialised so that
every `file` leaf — and only a `file` leaf — becomes the base64 of its bytes, in place. This is the
REST convention rather than an HTTP standard. The substitution is unconditional; to transmit a file's
handle instead of its bytes, stringify it yourself first (e.g. embed `json.stringify(value = a_file)`
as a string). The tree may carry secrets, revealed only to the destination."
data json(value: unknown of private)

// A request body: exactly one of the four shapes. (A `type` synonym carries no `@"..."` annotation.)
type body = text | binary | multipart | json

@"A text form field: the field named @name@ with the text @content@ (which may be a secret)."
data multipart_text(name: string, content: string of private)

@"A file form field: the field named @name@ carrying the file @content@, advertised with @filename@. Its
per-part Content-Type is the file's recorded content type."
data multipart_file(name: string, filename: string, content: file)

// One `multipart/form-data` part: a text field or a file field.
type multipart_part = multipart_text | multipart_file

@"Perform an HTTP request to @url@ with @method@, the given @headers@ and @body@, and return the
response @status@, its @headers@ (names lowercased; repeated headers joined with \", \") and its @body@
text. Only @url@ is required — the defaults spell a plain GET with no headers and no body. @body@ is
one of `http.text` / `http.binary` / `http.multipart` / `http.json`, or `null` for no body at all. Each
header value and a private body surface may be a secret, submitted to @url@'s server, while @url@ and
@method@ stay public. A non-2xx response is returned as its @status@ to branch on; a request that never
completes throws `fetch_error`."
external agent fetch(
  @"The absolute URL to request; public by type (a URL leaks into logs and proxies, so a secret here is a type error)." url: string,
  @"The HTTP method, e.g. \"GET\" / \"POST\" (case-insensitive); the default reads. For GET / HEAD the @body@ is not sent." method: string ?= "GET",
  @"Request headers by name; each value may be a secret, revealed only to @url@'s server." headers: record[string of private] ?= {},
  @"The request body: `http.text` / `http.binary` / `http.multipart` / `http.json`, or `null` for NO body; dropped for GET / HEAD." body: body | null ?= null,
) -> { status: integer, headers: record[string], body: string } with io | prelude.throw[fetch_error] from "http"

@"Exactly `fetch`'s request, but capturing the response body as a downloaded `file` rather than as
text: the bytes stream straight to the blob store and the reply carries only the handle, so they never
touch the value plane, the durable call record, or the trace. It captures the whole response body, so
an embedded base64 field inside a JSON reply is an ordinary `fetch` plus `files.from_base64` instead.
The downloaded file's recorded content type is the response's `Content-Type`
(`application/octet-stream` when the server sent none), and the returned @headers@ are normalised as
`fetch`'s are (names lowercased; repeated headers joined with \", \"). A non-2xx reply's body is
captured too, so @status@ says whether the download is the resource; a request that never completes
throws `fetch_error`."
external agent fetch_file(
  @"The absolute URL to request; public by type (a URL leaks into logs and proxies, so a secret here is a type error)." url: string,
  @"The HTTP method, e.g. \"GET\" / \"POST\" (case-insensitive); the default reads. For GET / HEAD the @body@ is not sent." method: string ?= "GET",
  @"Request headers by name; each value may be a secret, revealed only to @url@'s server." headers: record[string of private] ?= {},
  @"The request body: `http.text` / `http.binary` / `http.multipart` / `http.json`, or `null` for NO body; dropped for GET / HEAD." body: body | null ?= null,
) -> { status: integer, headers: record[string], file: file } with io | prelude.throw[fetch_error] from "http"

@"POST @body@ — a JSON value tree — to @url@ as application/json with the given @headers@, and return
the reply parsed into its document value. @body@ and each header value may be a secret, submitted only
to @url@'s server; a `file` anywhere in @body@ rides as base64.

A non-2xx is classified here rather than reported: it throws `api_failure` — `auth_error` for 401 /
403, `api_error` otherwise — carrying the status, @context@ and the server's own body. A transport
failure throws `fetch_error`, and a 2xx body that is not JSON throws `json.parse_error` (an empty 2xx
body is `null`). Call `fetch` directly to send already-serialized text, to keep the raw reply text, or
to branch on a status rather than throw on it."
agent post_json(
  @"The absolute URL to POST to; public by type." url: string,
  @"The JSON body as a value tree (records / arrays / scalars / files, mixed); may carry secrets." body: unknown of private,
  @"Which call this is, in the caller's own words (e.g. \"gmail.send\") — it rides on the thrown failure, which is read far from here." context: string,
  @"Extra headers by name (the caller wins over the application/json default on a shared name); values may be secrets." headers: record[string of private] ?= {},
) -> unknown with io | prelude.throw[api_failure | fetch_error | parse_error] {
  // An `http.json` body serialises the tree (files -> base64 in place) and sets the application/json
  // Content-Type as a default the caller's headers can override.
  let response = fetch(url = url, method = "POST", headers = headers, body = json(value = body))
  if (response.status >= 200 && response.status < 300) {
    // An empty body (a 204-style reply) carries no document, so it reads as `null`.
    if (response.body == "") {
      null
    } else {
      parse(text = response.body)
    }
  } else {
    prelude.throw(error = classify_status(status = response.status, context = context, message = response.body))
  }
}

// The classified failure of an AUTHENTICATED API call, drawing one line: WHO HAS TO ACT. It is shared
// stdlib vocabulary so a `supervise` converter matches `http.auth_error` once and covers every API
// behind it. Packages whose failures are not an HTTP status keep their own sums.

@"An authenticated API call was rejected over the identity of the caller: the endpoint answered 401 or
403, so the credential is what failed — revoked, expired, or scoped too narrowly. Retrying with the
same credential gives the same answer; the recovery is a fresh resolution of it, so the ordinary
composition is a `supervise` converter signalling `supervise.interrupted`. @context@ says which call
failed in the caller's own words and @message@ carries the server's own body, kept apart so a renderer
can show either alone.

403 is read as auth even though some APIs also spend it on quota exhaustion; a quota 403 that is
replayed answers the same way."
data auth_error(
  @"The rejecting status: 401 or 403." status: integer,
  @"Which call failed, in the caller's own words — for a human reading the error (e.g. \"gmail.send\")." context: string,
  @"The response body, or the reason the caller has instead." message: string,
)

@"An authenticated API call failed for something other than the credential: a non-2xx @status@ that is
not 401 / 403. Which failures are worth repeating is read off @status@ — 408 / 429 / 5xx are the
transient ones, and every other status repeats its answer until the argument changes — which is why
the status rides on the error rather than being folded into a sentence. @context@ says which call
failed in the caller's own words; @message@ carries the server's own body verbatim."
data api_error(
  @"The failing non-2xx status." status: integer,
  @"Which call failed, in the caller's own words — for a human reading the error (e.g. \"tavily.search\")." context: string,
  @"The response body, or the reason the caller has instead." message: string,
)

// An authenticated API call's failure, classified: the credential's problem, or the call's. (Type
// synonyms take no docs.)
type api_failure = auth_error | api_error

@"Classify a non-2xx @status@ into the shared vocabulary: 401 and 403 are `auth_error` (a credential
problem no retry with the same credential can fix), every other status is `api_error`. @context@ and
@message@ ride onto whichever variant comes out, unchanged, and the status is retained so a downstream
retry policy reads a number rather than an English sentence. It answers a value, so the caller chooses
whether to throw it, fold it, or attach it to an outcome."
agent classify_status(
  @"The response's non-2xx status code." status: integer,
  @"Which call failed, in the caller's own words — for a human reading the error." context: string,
  @"The response body, or the reason the caller has instead." message: string,
) -> api_failure {
  // 401 and 403 are the only statuses about the caller rather than the call; everything else —
  // including a 407 proxy challenge, which is the network's credential — is the call's own failure.
  if (status == 401 || status == 403) {
    auth_error(status = status, context = context, message = message)
  } else {
    api_error(status = status, context = context, message = message)
  }
}
