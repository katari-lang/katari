// The `prelude.record` sub-module: operations over the homogeneous string-keyed map `record[T]` (a
// parsed JSON object's entries, an env listing, ...). Called qualified via the default import.

@"Read the value under @key@, or `null` when the key is absent."
primitive agent get[T](target: record[T], key: string) -> T | null

@"A copy of the record with @value@ under @key@ (replacing an existing entry)."
primitive agent set[T](target: record[T], key: string, value: T) -> record[T]

@"A copy of the record with @value@ under @key@ when @value@ is present, and @target@ unchanged when it
is `null` — the way to build a conditionally present field, since an omitted key and a key holding
`null` are different documents at the boundaries that read them. To store an explicit JSON null
instead, call `set`; this agent reads `null` as absence."
agent set_if[T](
  @"The record being built." target: record[T],
  @"The key to set when @value@ is present." key: string,
  @"The value, or `null` to leave @target@ exactly as it is." value: T | null,
) -> record[T] {
  match (value) {
    case null -> target
    case present -> set(target = target, key = key, value = present)
  }
}

@"A copy of the record without @key@ (unchanged when the key is absent)."
primitive agent remove[T](target: record[T], key: string) -> record[T]

@"Every key, in sorted order."
primitive agent keys(target: record[unknown]) -> array[string]

@"Whether @key@ is present."
primitive agent has(target: record[unknown], key: string) -> boolean

@"The number of entries."
primitive agent size(target: record[unknown]) -> integer

@"Every entry as a @[key, value]@ pair, in sorted key order — the record's `for`-iterable view."
primitive agent entries[T](target: record[T]) -> array[[string, T]]

@"The two records' entries in one record; on a shared key the right value wins (the override direction
of layered configuration, e.g. default headers extended per call)."
primitive agent merge[T](left: record[T], right: record[T]) -> record[T]

// `{}` is the empty record literal — except immediately after a `->` (a match arm, an agent body),
// where a bare `{}` parses as an empty block and answers `null`; write `({})` there.
