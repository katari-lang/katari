// The `prelude.credentials` sub-module: the one shape a package's provider names its credential
// source with (see docs/2026-07-22-credentials-unification.md). Both variants are NAMES — where the
// credential lives, never its value — so an app's dataflow never touches the secret itself, and
// `resolve` reads the CURRENT value at each use (an env rotation via `katari env set` and an OAuth
// refresh both land without a restart).
//
// The local `env` / `oauth` data constructors shadow the same-named module aliases, so the two
// resolvers are imported by name (the `prelude.http` / local-`json` precedent).

// `missing_secret` is imported as a TYPE only (for `resolve`'s throw row) — the `type` prefix selects the
// type namespace.
import { get_secret, type missing_secret } from prelude.env
import { token, type server_error } from prelude.oauth

@"A named secret in the project's env store — `resolve` reads it with `env.get_secret` at each use,
so a rotated secret lands without a restart. Missing at resolve time throws `env.missing_secret`."
data env(@"The secret entry's key in the project's env store." key: string)

@"A named credential in the runtime's credential store — `resolve` reads it with `oauth.token` at
each use, so a refreshed token is always the current one. An unusable credential throws
`oauth.server_error` (and may park the run on an authorization escalation, like any `oauth.token`)."
data oauth(@"The credential's name in the runtime's credential store." name: string)

// Where a credential lives: the app picks the variant, the package never knows which.
// (Type synonyms take no docs.)
type source = env | oauth

@"Resolve a credential source to its CURRENT value, as a private string. Called by a package's
provider once per `credential` request, never cached — freshness is the point.

A BOOT-TIME PREFLIGHT is this agent under `prelude.catch`, one source at a time: catching folds an
unset `env` secret into a value the app collects and reports as one console line, instead of meeting
the gap hours later on first use. It is spelt at the app because WHICH sources matter, and what a
missing one should say, are the app's — a bulk checker in this module could only guess both, and it
guessed by throwing a list of bare names. DISCARD THE VALUE INSIDE THE CAUGHT TASK
(`let _resolved = resolve(source = ...)` then `null`): a preflight wants the THROW, not the secret, and
a task answering `string of private` taints `catch`'s whole result union private — which is the type
system correctly refusing to let a secret ride out on the same value as its absence."
agent resolve(source: source) -> string of private with io | prelude.throw[missing_secret | server_error] {
  match (source) {
    case env(key => key) -> get_secret(key = key)
    case oauth(name => name) -> token(name = name)
  }
}
