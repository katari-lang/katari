// The `prelude.credentials` sub-module: the one shape a package's provider names its credential
// source with (see docs/2026-07-22-credentials-unification.md). Both variants are NAMES — where the
// credential lives, never its value — so an app's dataflow never touches the secret itself, and
// `resolve` reads the CURRENT value at each use (an env rotation via `katari env set` and an OAuth
// refresh both land without a restart).
//
// The local `env` / `oauth` data constructors shadow the same-named module aliases, so the two
// resolvers are imported by name (the `prelude.http` / local-`json` precedent).

// `missing_secret` is imported as BOTH the value constructor (for `preflight`'s payload match) and the
// type (for the throw rows) — the `type` prefix selects the type namespace, the bare name the value one.
import { get_secret, missing_secret, type missing_secret } from prelude.env
import { token, type server_error } from prelude.oauth

@"A named secret in the project's env store — `resolve` reads it with `env.get_secret` at each use,
so a rotated secret lands without a restart. Missing at resolve time throws `env.missing_secret`."
data env(@"The secret entry's key in the project's env store." key: string)

@"A named credential in the runtime's credential store — `resolve` reads it with `oauth.token` at
each use, so a refreshed token is always the current one. An unusable credential throws
`oauth.server_error` (and may park the run on an authorization escalation, like any `oauth.token`)."
data oauth(@"The credential's name in the runtime's credential store." name: string)

// Where a credential lives: the app picks the variant, the package never knows which.
// (Type synonyms take no docs.)
type source = env | oauth

@"Resolve a credential source to its CURRENT value, as a private string. Called by a package's
provider once per `credential` request, never cached — freshness is the point."
agent resolve(source: source) -> string of private with io | prelude.throw[missing_secret | server_error] {
  match (source) {
    case env(key => key) -> get_secret(key = key)
    case oauth(name => name) -> token(name = name)
  }
}

@"A preflight found credential sources that do not resolve — their NAMES (an `env` source's key, an
`oauth` source's credential name) are listed in @names@. Thrown by `preflight` so a caller can name EVERY
gap at once (one deploy-time console line) instead of surfacing them one at a time on first use. A
transient `oauth` failure is NOT collected here — it re-raises as `oauth.server_error` (a blip, not a
config gap)."
data unresolved(@"The names of the sources that did not resolve." names: array[string])

@"List which of @sources@ do NOT resolve — the value twin of `preflight` (as `store.get_text` is to
`store.get`): an empty array means every source resolved; a non-empty one names each gap (an `env`
source's key, an `oauth` source's name), left-to-right. Use it when the caller wants to REPORT the
gaps — a console line, a status message — without unwinding; `preflight` is this check plus the loud
throw. A transient `oauth` failure re-raises as `oauth.server_error` (a blip, not a config gap); an
unauthorized `oauth` credential PAUSES on its authorization escalation exactly as a `resolve` would."
agent check(sources: array[source]) -> array[string] with io | prelude.throw[server_error] {
  // The display name a missing source is listed under: an `env` source's key, an `oauth` source's name.
  agent name_of(source: source) -> string {
    match (source) {
      case env(key => key) -> key
      case oauth(name => name) -> name
    }
  }
  // Resolve one source, folding a missing `env` secret to `false`; a transient `oauth` `server_error`
  // re-raises (a blip, not a config gap), and an unauthorized `oauth` pauses on its authorization
  // escalation exactly as `resolve` would.
  agent resolves(source: source) -> boolean with io | prelude.throw[server_error] {
    use handler {
      request prelude.throw(error: missing_secret | server_error) -> never {
        match (error) {
          case missing_secret(key => _, message => _) -> { break false }
          case rest -> { prelude.throw(error = rest) }
        }
      }
    }
    // The value itself is not wanted — only whether resolving it throws — so it is discarded outright.
    let _ = resolve(source = source)
    true
  }
  for (let source in sources, var gathered: array[string] = []) {
    if (resolves(source = source)) {
      next
    } else {
      next with { gathered = array.append(target = gathered, value = name_of(source = source)) }
    }
  } then (_sources) { gathered }
}

@"Verify EVERY source in @sources@ resolves, in one left-to-right pass, and throw `unresolved` naming ALL
that do not — the bulk preflight an app runs at boot so a missing credential fails LOUD at deploy (one
line listing every gap) rather than crashing hours later on first use. Each source is checked with
`resolve` (reading its CURRENT value, then discarding it — freshness stays `resolve`'s at each real use):
a source whose `env` secret is unset is collected by name; a transient `oauth` failure re-raises as
`oauth.server_error` (a blip, not a config gap); an unauthorized `oauth` credential PAUSES on its
authorization escalation exactly as a `resolve` would, so preflight is also where an app can trigger the
OAuth login. Returns `null` when every source resolves; the gap LIST without the throw is `check`."
agent preflight(sources: array[source]) -> null with io | prelude.throw[unresolved | server_error] {
  let missing_names = check(sources = sources)
  // No `else`: the throw branch types as `never`, so the whole `if` is `never | null` — the declared
  // `null` return, without a branch written only to spell it.
  if (array.length(target = missing_names) > 0) {
    prelude.throw(error = unresolved(names = missing_names))
  }
}
