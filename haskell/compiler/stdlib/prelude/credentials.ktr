// The `prelude.credentials` sub-module: the one shape a package's provider names its credential
// source with. Both variants are names — where the credential lives, never its value — and `resolve`
// reads the current value at each use, so an env rotation or an OAuth refresh lands without a restart.

// The local `env` / `oauth` data constructors shadow the same-named module aliases, so the two
// resolvers are imported by name. `missing_secret` is imported as a type only (for `resolve`'s row).
import { get_secret, type missing_secret } from prelude.env
import { token, type server_error } from prelude.oauth

@"A named secret in the project's env store — `resolve` reads it with `env.get_secret` at each use, so
a rotated secret lands without a restart. Missing at resolve time throws `env.missing_secret`."
data env(@"The secret entry's key in the project's env store." key: string)

@"A named credential in the runtime's credential store — `resolve` reads it with `oauth.token` at each
use, so a refreshed token is always the current one. An unusable credential throws `oauth.server_error`
(and may park the run on an authorization escalation, like any `oauth.token`)."
data oauth(@"The credential's name in the runtime's credential store." name: string)

// Where a credential lives: the app picks the variant, the package never knows which.
// (Type synonyms take no docs.)
type source = env | oauth

@"Resolve a credential source to its current value, as a private string — called by a package's
provider once per `credential` request, never cached. Throws whichever the variant throws:
`env.missing_secret` or `oauth.server_error`. A task answering `string of private` taints a
`prelude.catch` over it private, so a boot-time preflight discards the resolved value and keeps only
the throw."
agent resolve(source: source) -> string of private with io | prelude.throw[missing_secret | server_error] {
  match (source) {
    case env(key => key) -> get_secret(key = key)
    case oauth(name => name) -> token(name = name)
  }
}
