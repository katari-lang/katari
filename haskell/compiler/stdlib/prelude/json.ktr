// The `prelude.json` sub-module: the JSON boundary, over PLAIN Katari values. A JSON document is not a
// dedicated tree type — it is an ordinary record / array / string / integer / number / boolean / null.
// One codec, shared with the FFI boundary, renders values to and from bare JSON; every reserved wire
// key lives in the `$katari_` namespace (a `file` is `{ $katari_ref: id }`, a `data` value is
// `{ $katari_constructor: name, $katari_value: {...} }`), which a program never authors.

@"A JSON document failed to parse: the text is not JSON. Thrown by `parse`."
data parse_error(message: string)

@"A value does not conform to the requested type's schema. Thrown by `validate`; `message` names the
offending path."
data validation_error(message: string)

@"Parse JSON text into the value it denotes — a record / array / string / integer / number / boolean /
null, or a `file` where the text carries a `$katari_ref` handle. A number without a fractional part
parses as `integer`. Malformed text throws `parse_error`."
primitive agent parse(@"The text of one complete JSON document." text: string) -> unknown with prelude.throw[parse_error]

@"Check @value@ against T's schema and return it unchanged, or throw `validation_error` naming the
offending path. A pure check — it never rewrites the value. Instantiate T explicitly (it appears only
in the result, so it cannot be inferred)."
primitive agent validate[T](@"The value to check against T." value: unknown) -> T with prelude.throw[validation_error]

@"Render ANY value as its compact JSON text — total and canonical (one value, one text). A document
value round-trips verbatim, while a `file`, a `data` value and a callable each become their handle
object, which makes this the read channel for showing an AI such a value. A secret operand taints the
whole result."
primitive agent stringify[T](value: T) -> string

// The total readers: plain Katari over `unknown`, for picking values out of a document of unknown or
// irregular shape without a shape filter at every step. A missing key, an out-of-range index or a
// wrong shape yields `null` / `""` / an empty container rather than an error, so probes chain freely.

@"The record @target@ holds (its entries), or the empty record if @target@ is not a record."
agent entries(target: unknown) -> record[unknown] {
  match (target) {
    case record(record_value) -> record_value
    // Parenthesised because a bare `{}` after `->` parses as an empty block (answering `null`), not
    // as the empty record literal.
    case _ -> ({})
  }
}

@"The array @target@ holds (its elements), or the empty array if @target@ is not an array."
agent items(target: unknown) -> array[unknown] {
  match (target) {
    case array(array_value) -> array_value
    case _ -> []
  }
}

@"The child at object key @key@ (`null` if @target@ is not a record or has no such key)."
agent field(target: unknown, key: string) -> unknown {
  match (target) {
    case record(record_value) -> record.get(target = record_value, key = key)
    case _ -> null
  }
}

@"The element at array index @index@ (`null` if @target@ is not an array or @index@ is out of range)."
agent element(target: unknown, index: integer) -> unknown {
  match (target) {
    case array(array_value) -> array.get(target = array_value, index = index)
    case _ -> null
  }
}

@"The string @target@ holds, or @fallback@ when it holds anything else — including the `null` an absent
`field` answers. @fallback@ defaults to `\"\"`, so the ordinary degrade-to-empty read needs no argument;
give it a placeholder to tell an absent field from one holding `\"\"`."
agent text(
  @"The document to read; any non-string answers @fallback@." target: unknown,
  @"The value when @target@ is not a string — including the `null` an absent `field` answers." fallback: string ?= "",
) -> string {
  match (target) {
    case string(string_value) -> string_value
    case _ -> fallback
  }
}
