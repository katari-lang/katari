// The `prelude.poll` sub-module: a durable subscription over a source that can only be asked. It ticks
// on a schedule, asks the caller's `fetch` what the source holds now, and hands each item it has not
// seen before to the caller's `deliver_to`.
//
// Delivery is at-least-once: an item is delivered one or more times, never zero. Exactly-once is built
// at the destination by making the delivery idempotent, keyed by `item.key`; the loop itself cannot
// give it without a transaction the source does not offer.
//
// `poll_since` / `classify` / `commit` / `mark_primed` (and `initial` / `load` / `persist` / `advance`)
// are internal machinery a caller never performs or handles; they are module members only because
// Katari has no module-private declarations.

@"One item as the subscription sees it: an identity, a position, and the payload — the whole adapter a
source package writes. @key@ is stable across listings and unique among the items that can be in the
memory at once; where identity alone is not enough (a recurring meeting whose occurrences share an id)
a discriminator joins into it, e.g. `id ++ \" \" ++ start`. @mark@ is the item's own position in the
source's receive clock, as epoch milliseconds; it is the only quantity that moves a `watermark` cursor,
and is unused under `seen_set`."
data item[T](
  @"The item's stable, unique dedup identity." key: string,
  @"The item's own arrival instant in the source's clock, epoch milliseconds (unused under `seen_set`)." mark: number,
  @"The payload handed to `deliver_to`." value: T,
)

@"Dedup by a monotone floor in the source's own receive clock — for a source that can be listed from an
instant (\"mail that arrived after T\"). The cursor advances to each delivered item's own @mark@, never
on the poller's clock and never past the tick that observed it, so neither a slow tick nor a
future-dated item moves it beyond what has been delivered. The memory alongside it is the keys at or
above the floor, so it stays constant-size however long the subscription runs.

@overlap@ is how far below the floor each fetch re-lists, in the same milliseconds — slack for a source
whose listing boundary is rounded or exclusive (Gmail's `after:` takes whole seconds, so `overlap =
1000` covers both readings). It costs no duplicates, since the keys inside it are the ones still
remembered; 0 fits an exact boundary."
data watermark(@"How far below the floor each fetch re-lists, in milliseconds; the keys inside it stay remembered." overlap: number)

@"Dedup by a bounded set of keys — for a source with no usable receive clock, only a window that slides
(\"meetings starting within the next 30 minutes\"). No cursor moves; every fetch sees the same `since`.
The memory is the most recent @capacity@ keys, forgotten by age.

An item still inside the window after @capacity@ other items have been delivered is delivered again,
so @capacity@ sits well above the largest number of items one window can hold (google_calendar uses 200
for a 30-minute lead). A seen-set subscription does not backfill under any `continuity`: with no floor
there is nothing to list from, so whatever crossed the window while it was down is gone."
data seen_set(@"How many keys to remember; must exceed the largest number of items one window can hold." capacity: integer)

// Which memory a subscription keeps. (Type synonyms take no docs.)
type dedup = watermark | seen_set

@"Skip whatever the source already holds when the subscription first starts, so it reports arrivals
rather than matches. Under `watermark` the cursor is primed at the starting instant, so the backlog is
never listed; under `seen_set` the first tick records its window without delivering, and delivery
begins with the tick after it."
data skip_backlog()

@"Deliver whatever the source already holds when the subscription first starts, then keep going. Under
`watermark` the cursor starts at the epoch, so the first tick lists the source's whole history — bound
it inside the `fetch` if that matters. Under `seen_set` there is no priming tick: the first window is
delivered."
data deliver_backlog()

// What the first activation does with the backlog. (Type synonyms take no docs.)
type backlog = skip_backlog | deliver_backlog

@"Keep the cursor in the store, at @key@, so it outlives the run that wrote it: every commit writes it,
and a fresh activation (a restart, a re-fork, a `supervise` re-run) reads it back and resumes. Under
`watermark` the items that arrived while the process was down are delivered rather than skipped; under
`seen_set` the window is not re-notified from scratch. @key@ resolves against the surrounding
`store.workspace` like any other, and each subscription takes its own — two sharing one overwrite each
other's memory."
data resume(@"The store key the cursor record lives at, relative to the current workspace." key: string)

@"Keep the cursor in the run alone (a handler `var`, durable across a crash-recovery restart of that
same run, and gone when the run ends). Every fresh activation re-primes, so whatever arrived between
activations is skipped. It fits where re-priming is the semantics — a subscription whose backlog is
worthless, a probe, a test."
data fresh()

// Where the cursor lives between activations. (Type synonyms take no docs.)
type continuity = resume | fresh

@"Internal to `subscribe`: the subscription is still recording its first tick, so items are remembered
rather than delivered."
data priming()

@"Internal to `subscribe`: the subscription is delivering."
data live()

// Whether a tick delivers or merely records. (Type synonyms take no docs.)
type phase = priming | live

@"Internal to `subscribe`: one remembered delivery — the item's @key@, and the @mark@ that decides when
the memory may forget it."
data delivered(@"The delivered item's dedup key." key: string, @"The delivered item's mark, in the source's clock." mark: number)

@"Internal to `subscribe`: a subscription's whole memory in one value, and so also what `resume` writes
to the store and an operator reads in the console."
data cursor(
  @"The floor in the source's clock; 0 under `seen_set`, which has no floor." floor: number,
  @"The keys remembered at or above the floor (or the last `capacity` keys under `seen_set`)." recent: array[delivered],
  @"Whether the first tick has finished recording." phase: phase,
)

@"Internal to `subscribe`: unseen and the subscription is live — deliver it, then commit."
data deliver()

@"Internal to `subscribe`: unseen but still priming — commit without delivering."
data remember()

@"Internal to `subscribe`: already remembered — do nothing."
data skip()

// One item's fate this tick. (Type synonyms take no docs.)
type verdict = deliver | remember | skip

@"Internal to `subscribe`: the instant this tick's fetch lists from — the floor minus the regime's
overlap, clamped at 0."
request poll_since() -> number

@"Internal to `subscribe`: one item's fate, decided against the memory and the phase — the one place
the memory is tested, so no other code re-tests it."
request classify(@"The item's dedup key." key: string) -> verdict

@"Internal to `subscribe`: fold one item into the memory and make it durable. Performed after its
delivery returns, so a failed delivery leaves the item uncommitted and the next tick lists it again."
request commit(
  @"The item's dedup key." key: string,
  @"The item's mark, in the source's clock." mark: number,
  @"The tick's scheduled instant — the ceiling this commit may not move the cursor past." tick: number,
) -> null

@"Internal to `subscribe`: end the priming tick, so an unseen item is delivered from here on. Performed
once, at the end of the first tick, so a crash partway through priming resumes as a priming tick."
request mark_primed() -> null

@"Internal to `subscribe`: the memory a subscription starts from when nothing is stored. This is the
one read of the poller's clock in a subscription's life, and only for a `watermark` that skips its
backlog, where the starting instant is the line between \"already there\" and \"arrived\"."
agent initial(@"The dedup regime." dedup: dedup, @"What to do with the backlog." backlog: backlog) -> cursor with io {
  match (backlog) {
    case deliver_backlog(_) -> cursor(floor = 0, recent = [], phase = live())
    case skip_backlog(_) -> {
      match (dedup) {
        // The floor starts at the current instant, so everything the source already holds sits below
        // it and is never listed. This clock read decides where "already there" ends, and nothing else.
        case watermark(overlap => _) -> cursor(floor = time.now(), recent = [], phase = live())
        // No floor to raise, so the backlog is skipped by recording the first tick instead.
        case seen_set(capacity => _) -> cursor(floor = 0, recent = [], phase = priming())
      }
    }
  }
}

@"Internal to `subscribe`: the memory this activation starts from — the stored one under `resume`, a
fresh one otherwise. A stored value that does not conform degrades to a fresh memory rather than
throwing, because a subscription that refuses to start is worse than one that re-primes."
agent load(
  @"The dedup regime." dedup: dedup,
  @"What to do with the backlog." backlog: backlog,
  @"Where the cursor lives." continuity: continuity,
) -> cursor with io | store.get {
  match (continuity) {
    case fresh(_) -> initial(dedup = dedup, backlog = backlog)
    // An explicit `match` rather than `store.get_or` because `initial` reads the clock: `get_or` takes
    // its fallback as an argument, so a resumed activation would read it and discard the answer.
    case resume(key => key) -> {
      match (store.get(key = key)) {
        case store.absent(key => _) -> initial(dedup = dedup, backlog = backlog)
        case store.found(value => stored) -> {
          // `catch` makes the stored-shape check total: a mismatch takes the same arm as an absent key.
          agent checked() -> cursor with prelude.throw[json.validation_error] {
            json.validate[cursor](value = stored)
          }
          match (prelude.catch(task = checked)) {
            case json.validation_error(message => _) -> initial(dedup = dedup, backlog = backlog)
            case validated -> validated
          }
        }
      }
    }
  }
}

@"Internal to `subscribe`: make the memory durable if the caller asked for a durable one. Called on
every commit, so the store write IS the commit; under `fresh` it is a no-op."
agent persist(@"Where the cursor lives." continuity: continuity, @"The memory to write." memory: cursor) -> null with store.set {
  match (continuity) {
    case fresh(_) -> null
    case resume(key => key) -> store.set(key = key, value = memory)
  }
}

@"Internal to `subscribe`: the memory with one delivered item folded in — where the two regimes
differ."
agent advance(
  @"The dedup regime." dedup: dedup,
  @"The memory before this delivery." memory: cursor,
  @"The delivered item's key." key: string,
  @"The delivered item's mark, in the source's clock." mark: number,
  @"The tick's scheduled instant." tick: number,
) -> cursor {
  match (dedup) {
    case watermark(overlap => overlap) -> {
      // The floor moves on the item's mark and only forward (a listing is rarely ordered exactly by
      // the receive clock), and never past the tick that observed it, so a future-dated item does not
      // park the cursor ahead of what has been delivered.
      let floor = math.max(left = memory.floor, right = math.min(left = mark, right = tick))
      // Forget by age alone: a key below the new fetch boundary can no longer be listed, and the key
      // keeps the item's true mark, so a future-dated item stays remembered while the cursor is below it.
      let kept = array.flatten(target = for (let entry in memory.recent) {
        next if (entry.mark >= floor - overlap) { [entry] } else { [] }
      })
      cursor(
        floor = floor,
        recent = array.append(target = kept, value = delivered(key = key, mark = mark)),
        phase = memory.phase,
      )
    }
    case seen_set(capacity => capacity) -> {
      // No floor to move; the memory is a bounded queue and the cap is what bounds it. See `seen_set`'s
      // own docs for the re-notification the cap allows.
      let grown = array.append(target = memory.recent, value = delivered(key = key, mark = mark))
      let total = array.length(target = grown)
      cursor(
        floor = memory.floor,
        recent = array.slice(target = grown, start = math.max(left = 0, right = total - capacity), end = total),
        phase = memory.phase,
      )
    }
  }
}

@"Poll a source on @schedule@ and deliver each item it has not seen before to @deliver_to@, forever —
the durable-subscription skeleton a source package composes instead of rewriting. Shaped like
`time.watch` (`-> never`, @deliver_to@'s effects @E@ flow to the caller's handlers unchanged), so it
composes under `parallel [ … ]` beside any other daemon.

Delivery is at-least-once: the commit lands after a delivery returns, so a crash or a throw in between
re-delivers exactly that item on the next tick. Exactly-once is built at the destination by making the
delivery idempotent, keyed by `item.key`.

@fetch@ is the whole adapter, and its contract is: given @since@ and @tick@, return every item at or
above @since@, oldest first, across every page of the source's pagination. The order is load-bearing —
the cursor then only passes items that were delivered — and so is draining every page, since a listing
cut off at a newest-first cap leaves the older items below the cursor. Returning an item again is free;
that is what the remembered keys are for.

With `skip_backlog` it reports arrivals: whatever the source already held is not delivered however well
it matches, and an old item that comes to match later is not delivered either (the fetch does not look
below the cursor). With `continuity = resume(key = ...)` a restart, a re-fork and a `supervise` re-run
all resume, delivering what arrived while it was down; with `fresh()` every activation re-primes and
that downtime is skipped.

There is no built-in retry: a failing @fetch@ or @deliver_to@ propagates and ends the subscription, and
resilience is composed at the call site (`supervise.forever` plus a converter). The first poll is one
@schedule@ occurrence in, and under `seen_set` + `skip_backlog` that first poll is the priming one, so
the earliest notification such a subscription produces is two occurrences after it starts."
agent subscribe[T, effect E](
  @"When each poll fires: a `time.interval(...)` or a `time.cron(...)`." schedule: time.schedule,
  @"The dedup regime: `watermark(overlap = ...)` or `seen_set(capacity = ...)`." dedup: dedup,
  @"What the first activation does with what the source already holds." backlog: backlog,
  @"Where the cursor lives between activations — `resume(key = ...)` to survive a restart, `fresh()` not to." continuity: continuity,
  @"List the source from @since@ as of @tick@: every item at or above @since@, oldest first, every page." fetch: agent (since: number, tick: number) -> array[item[T]] with E,
  @"Called once per item not seen before; its effects flow to the caller's handlers unchanged." deliver_to: agent (value: T) -> null with E,
) -> never with E | io | store.get | store.set {
  // The memory is a handler `var` with one owner, seeded from the store so a fresh activation resumes.
  // `time.watch` owns the loop, so the durable footprint stays flat however long the subscription runs.
  use handler (var memory: cursor = load(dedup = dedup, backlog = backlog, continuity = continuity)) {
    request poll_since() {
      next match (dedup) {
        // The overlap is subtracted here, once, so what the fetch re-lists is what the memory still
        // remembers.
        case watermark(overlap => overlap) -> math.max(left = 0, right = memory.floor - overlap)
        case seen_set(capacity => _) -> memory.floor
      }
    }
    request classify(key: string) {
      let seen = for (let entry in memory.recent) { next entry.key }
      next match (array.index_of(target = seen, value = key)) {
        case null -> {
          match (memory.phase) {
            case live(_) -> deliver()
            case priming(_) -> remember()
          }
        }
        case _ -> skip()
      }
    }
    request commit(key: string, mark: number, tick: number) {
      let advanced = advance(dedup = dedup, memory = memory, key = key, mark = mark, tick = tick)
      // The durable write and the var move together: after this returns the item is committed both in
      // this run and across restarts.
      persist(continuity = continuity, memory = advanced)
      next null with { memory = advanced }
    }
    request mark_primed() {
      match (memory.phase) {
        // Already live: no durable write to spend on every later tick.
        case live(_) -> { next null }
        case priming(_) -> {
          let advanced = cursor(floor = memory.floor, recent = memory.recent, phase = live())
          persist(continuity = continuity, memory = advanced)
          next null with { memory = advanced }
        }
      }
    }
  }
  // A local agent because it captures @fetch@ and @deliver_to@. The occurrence's scheduled instant does
  // not decide what is new — the memory does — it only caps how far the cursor may travel this tick.
  agent poll_on_tick(time: number) -> null with E | poll_since | classify | commit | mark_primed {
    for (let entry in fetch(since = poll_since(), tick = time)) {
      // Deliver-then-commit, per item: a tick that fails halfway leaves the rest of its batch above
      // the cursor, so the next tick lists them again.
      match (classify(key = entry.key)) {
        case deliver(_) -> {
          deliver_to(value = entry.value)
          commit(key = entry.key, mark = entry.mark, tick = time)
        }
        case remember(_) -> commit(key = entry.key, mark = entry.mark, tick = time)
        case skip(_) -> null
      }
    }
    // Priming ends once the whole first tick has been recorded, so a crash partway through it resumes
    // as a priming tick instead of delivering the part it never reached.
    mark_primed()
  }
  time.watch(schedule = schedule, deliver_to = poll_on_tick)
}
