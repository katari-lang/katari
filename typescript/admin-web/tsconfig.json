{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true
  },
  "include": ["src"],
  // The wire drift trip-wire references the runtime's Node-flavoured source, so it is checked on its own
  // (see `tsconfig.drift.json`) and must not enter this browser program.
  "exclude": ["src/api/wire-drift.ts"]
}
